# Local legacy importer only. Keep this file at the repository root.
# Copy to .env and fill locally; never commit .env or place it under www/.
SUPABASE_URL=https://your-local-or-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-local-or-staging-service-role-key
ALLOW_DUPLICATE_IMPORT=false

# Readings API smoke test (scripts/api/send-reading.js). Staging while testing.
CPM_API_URL=https://your-deployment.example/api/v1/readings/
CPM_API_EMAIL=ingestion-account@example.com
CPM_API_PASSWORD=set-locally-never-commit

# Staging integration tests (tests/db-staging.test.js, RUN_DB_TESTS=1 npm run test:db).
# Must be the STAGING project; the tests refuse the live project ref.
STAGING_DB_URL=postgresql://postgres:<password>@db.<staging-ref>.supabase.co:5432/postgres
STAGING_SUPABASE_URL=https://<staging-ref>.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=<staging publishable key>
STAGING_SUPER_ADMIN_EMAIL=
STAGING_SUPER_ADMIN_PASSWORD=
STAGING_ADMIN_EMAIL=
STAGING_ADMIN_PASSWORD=
STAGING_STATIONARY_TEST_POINT_ID=

# Visual baseline capture (scripts/capture-screenshots.js). Point it at the
# STAGING project: the committed browser config targets live, and signed-in
# screenshots of live would contain client data. Use an admin account so the
# admin page is captured too.
CPM_SCREENSHOT_SUPABASE_URL=https://your-staging-project.supabase.co
CPM_SCREENSHOT_SUPABASE_KEY=your-staging-publishable-key
CPM_SCREENSHOT_EMAIL=an-admin@staging.example
CPM_SCREENSHOT_PASSWORD=the-staging-password
